@article{BENAVENTE2022125841,
  title = {Approximately Dual Pairs of Wavelet Frames},
  author = {Benavente, Ana and Christensen, Ole and Hasannasab, Marzieh and Kim, Hong Oh and Kim, Rae Young and Kovac, Federico D.},
  year = 2022,
  journal = {Journal of Mathematical Analysis and Applications},
  volume = {507},
  number = {2},
  pages = {125841},
  issn = {0022-247X},
  doi = {10.1016/j.jmaa.2021.125841},
  abstract = {This paper deals with structural issues concerning wavelet frames and their dual frames. It is known that there exist wavelet frames aj/2{$\psi$}(aj{$\cdot-$}kb)j,k{$\in$}Z in L2(R) for which no dual frame has wavelet structure. We first generalize this result by proving that there exist wavelet frames for which no approximately dual frame has wavelet structure. Motivated by this we show that by imposing a very mild decay condition on the Fourier transform of the generator {$\psi\in$}L2(R), a certain oversampling aj/2{$\psi$}(aj{$\cdot-$}kb/N)j,k{$\in$}Z indeed has an approximately dual wavelet frame; most importantly, by choosing the parameter N{$\in$}N sufficiently large we can get as close to perfect reconstruction as desired, which makes the approximate dual frame pairs perform equally well as the classical dual frame pairs in applications.},
  keywords = {Almost perfect reconstruction,Approximately dual frames,Wavelet frames}
}

